rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- /users/{uid} ----------
    // The profile document itself is server-managed: it is created and
    // updated exclusively by Cloud Functions using the Admin SDK, which
    // bypasses these rules entirely. Clients never write to this document
    // directly (e.g. goal/settings changes go through a callable that can
    // validate and stamp goalUpdatedAt server-side). Owners may still read
    // their own profile.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // ---------- /users/{uid}/meta/aiQuota ----------
      // Fully server-managed rate-limit counter. If clients could read it,
      // they could infer exact quota internals and time abuse around reset
      // boundaries; if clients could write it, they could reset or inflate
      // their own quota. Only Cloud Functions (Admin SDK) touch this doc.
      match /meta/aiQuota {
        allow read, write: if false;
      }

      // ---------- /users/{uid}/workoutLogs/{logId} ----------
      // Logs are append-only / immutable: once a workout is logged it
      // cannot be edited or deleted, even by its owner, so history stays
      // trustworthy for streaks, stats and any downstream aggregation.
      match /workoutLogs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidWorkoutLog(request.resource.data);
        allow update, delete: if false;
      }

      // ---------- /users/{uid}/machineStats/{machineId} ----------
      // Written only by a Cloud Functions trigger (Admin SDK) that derives
      // per-machine stats from workout logs. Owner may read.
      match /machineStats/{machineId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /history/{entryId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // ---------- /users/{uid}/daySessions/{date} ----------
      // The single client-owned, mutable record of a calendar day - doc ID
      // is the "YYYY-MM-DD" date itself (one session per day, replacing the
      // old plans/current + trackedSessions split), directly editable to
      // support per-field autosave and inline focus/move edits without a
      // Cloud Function round-trip. This deliberately trades away the
      // append-only guarantee workoutLogs has - accepted as the cost of
      // fast, serverless editing for a fresh/demo dataset. `createdAt` and
      // `gymId` are immutable after create; moving a day to another date is
      // a client-side delete-and-recreate, not a mutation of `date`.
      match /daySessions/{date} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidNewDaySession(date, request.resource.data);
        allow update: if isOwner(uid) && isValidDaySessionUpdate();
        allow delete: if isOwner(uid);
      }
    }

    function isValidWorkoutLog(data) {
      let allowedKeys = ['mode', 'gymId', 'date', 'bodyParts', 'exercises', 'createdAt'];
      return data.keys().hasOnly(allowedKeys)
        && data.mode in ['simple', 'detailed']
        && data.date is timestamp;
    }

    // NOTE: the rules language has no loop/lambda construct (no .map/.filter
    // with a predicate over arbitrary-length lists), so - exactly like
    // isValidWorkoutLog above, which never inspects inside its `exercises`
    // array either - validation here is necessarily shallow: it bounds the
    // list size and checks top-level field shape, but does not walk into
    // each exercise/set to range-check reps/weightKg. That's enforced
    // client-side (SetEditor's stepper bounds); a malicious client with
    // direct Firestore access could still write an out-of-range set.
    function isValidNewDaySession(date, data) {
      let allowedKeys = ['date', 'focus', 'gymId', 'exercises', 'createdAt', 'updatedAt'];
      let allowedFocus = ['chest', 'back', 'legs', 'core', 'cardio', 'upper_body', 'other', 'rest'];
      return data.keys().hasOnly(allowedKeys)
        && data.date == date && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.focus in allowedFocus
        && (data.gymId == null || data.gymId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.exercises is list && data.exercises.size() <= 20;
    }

    function isValidDaySessionUpdate() {
      let allowedChangeKeys = ['exercises', 'updatedAt', 'focus'];
      let data = request.resource.data;
      let allowedFocus = ['chest', 'back', 'legs', 'core', 'cardio', 'upper_body', 'other', 'rest'];
      return data.diff(resource.data).affectedKeys().hasOnly(allowedChangeKeys)
        && data.focus in allowedFocus
        && data.updatedAt is timestamp
        && data.exercises is list && data.exercises.size() <= 20;
    }

    // ---------- /gyms/{gymId} ----------
    // Shared/global directory of gyms. Any signed-in user may read and may
    // crowdsource a new gym. Regular users may only bump memberCount in v1;
    // renaming or deleting a gym is deliberately out of scope to avoid
    // vandalism of shared data without a moderation layer.
    match /gyms/{gymId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNewGym(request.resource.data);
      allow update: if isSignedIn() && onlyMemberCountChanged();
      allow delete: if false;

      match /machines/{machineId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidNewMachine(request.resource.data);
        allow update: if isSignedIn() && onlyNameOrArchivedChanged();
        allow delete: if false;
      }
    }

    function isValidNewGym(data) {
      let allowedKeys = ['name', 'createdBy', 'createdAt', 'memberCount', 'location'];
      return data.keys().hasOnly(allowedKeys)
        && data.createdBy == request.auth.uid
        && data.name is string && data.name.size() <= 80
        && data.createdAt is timestamp
        && data.memberCount == 0
        && (data.location == null || isValidGymLocation(data.location));
    }

    function isValidGymLocation(location) {
      return location.keys().hasOnly(['city', 'country'])
        && location.city is string
        && location.country is string;
    }

    function onlyMemberCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']);
    }

    function isValidNewMachine(data) {
      let allowedKeys = ['name', 'category', 'addedBy', 'createdAt', 'archived'];
      let allowedCategories = ['chest', 'back', 'legs', 'core', 'cardio', 'upper_body', 'other'];
      return data.keys().hasOnly(allowedKeys)
        && data.addedBy == request.auth.uid
        && data.name is string && data.name.size() <= 80
        && data.category in allowedCategories
        && data.createdAt is timestamp
        && data.archived == false;
    }

    function onlyNameOrArchivedChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'archived']);
    }

    // ---------- /system/featureFlags ----------
    // Server/Admin-SDK only. Callable Cloud Functions check this flag
    // (e.g. an AI kill-switch) server-side; clients never need direct
    // access, so both read and write are denied entirely to shrink the
    // attack surface.
    match /system/featureFlags {
      allow read, write: if false;
    }
  }
}
