# Copy to .env.local and fill in with your Firebase project's web app config
# (Firebase Console > Project Settings > General > Your apps > SDK setup and config)
VITE_FIREBASE_API_KEY=
# Use the SAME domain you actually serve the app from (e.g. <project>.web.app),
# not necessarily the <project>.firebaseapp.com default shown in the console.
# Safari's Intelligent Tracking Prevention partitions storage between the two,
# which breaks Google sign-in if authDomain and the serving domain differ.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" to point a local dev server at real Firebase resources
# instead of the local emulator suite.
VITE_USE_EMULATORS=true
